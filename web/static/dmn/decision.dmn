<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:dc="http://www.omg.org/spec/DMN/20180521/DC/" xmlns:di="http://www.omg.org/spec/DMN/20180521/DI/" xmlns:dmndi="https://www.omg.org/spec/DMN/20191111/DMNDI/" id="Definitions_change_check" name="Change Check decision model" namespace="https://github.com/akirykouski/kakashi_public/decision" exporter="kakashi core.dmn" exporterVersion="1">
  <decision id="Decision_change" name="Change decision">
    <description>What may be done about a proposed supplier change and who decides. Never an approval: the best outcome is 'proceed under standard change control'.</description>
    <decisionTable id="DecisionTable_change" hitPolicy="FIRST">
      <input id="Input_change_class" label="Change class">
        <inputExpression id="InputExpression_change_class" typeRef="string">
          <text>change_class</text>
        </inputExpression>
        <inputValues id="InputValues_change_class">
          <text>"SourceChange","SubTierSupplierChange","LocationChange","ShippingLocationChange","MaterialChange","CoatingChange","SpecialProcessChange","ProcessChange","EquipmentChange","ToolingChange","TestMethodChange","SoftwareChange","DesignChange","PackagingChange","ProductionResumptionChange","ScheduleChange","PriceChange"</text>
        </inputValues>
      </input>
      <input id="Input_R1a" label="R1a fired">
        <inputExpression id="InputExpression_R1a" typeRef="boolean">
          <text>fired_R1a</text>
        </inputExpression>
      </input>
      <input id="Input_R1b" label="R1b fired">
        <inputExpression id="InputExpression_R1b" typeRef="boolean">
          <text>fired_R1b</text>
        </inputExpression>
      </input>
      <input id="Input_R2" label="R2 fired">
        <inputExpression id="InputExpression_R2" typeRef="boolean">
          <text>fired_R2</text>
        </inputExpression>
      </input>
      <input id="Input_R3" label="R3 fired">
        <inputExpression id="InputExpression_R3" typeRef="boolean">
          <text>fired_R3</text>
        </inputExpression>
      </input>
      <input id="Input_R4" label="R4 fired">
        <inputExpression id="InputExpression_R4" typeRef="boolean">
          <text>fired_R4</text>
        </inputExpression>
      </input>
      <input id="Input_R5" label="R5 fired">
        <inputExpression id="InputExpression_R5" typeRef="boolean">
          <text>fired_R5</text>
        </inputExpression>
      </input>
      <input id="Input_R6" label="R6 fired">
        <inputExpression id="InputExpression_R6" typeRef="boolean">
          <text>fired_R6</text>
        </inputExpression>
      </input>
      <input id="Input_R7" label="R7 fired">
        <inputExpression id="InputExpression_R7" typeRef="boolean">
          <text>fired_R7</text>
        </inputExpression>
      </input>
      <input id="Input_R8" label="R8 fired">
        <inputExpression id="InputExpression_R8" typeRef="boolean">
          <text>fired_R8</text>
        </inputExpression>
      </input>
      <output id="Output_row_id" label="Row" name="row_id" typeRef="string" />
      <output id="Output_allowed_actions" label="Allowed actions" name="allowed_actions" />
      <output id="Output_decider" label="Decides" name="decider" typeRef="string" />
      <output id="Output_rests_on" label="Rests on" name="rests_on" />
      <rule id="Rule_D1">
        <description>The new coating or material contains a substance the law restricts in the part's market. No deviation can lift a legal ban.</description>
        <inputEntry id="Rule_D1_in0">
          <text>-</text>
        </inputEntry>
        <inputEntry id="Rule_D1_in1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="Rule_D1_in2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="Rule_D1_in3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="Rule_D1_in4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="Rule_D1_in5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="Rule_D1_in6">
          <text>true</text>
        </inputEntry>
        <inputEntry id="Rule_D1_in7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="Rule_D1_in8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="Rule_D1_in9">
          <text>-</text>
        </inputEntry>
        <outputEntry id="Rule_D1_out0">
          <text>"D1"</text>
        </outputEntry>
        <outputEntry id="Rule_D1_out1">
          <text>["stop"]</text>
        </outputEntry>
        <outputEntry id="Rule_D1_out2">
          <text>"plant quality manager"</text>
        </outputEntry>
        <outputEntry id="Rule_D1_out3">
          <text>["R5", "Directive 2000/53/EC Annex II", "Regulation (EU) 2026/1738"]</text>
        </outputEntry>
      </rule>
      <rule id="Rule_D2">
        <description>The new supplier is conditional: it may not receive new parts until the open 8D is closed and a re-audit passes.</description>
        <inputEntry id="Rule_D2_in0">
          <text>"SourceChange","SubTierSupplierChange"</text>
        </inputEntry>
        <inputEntry id="Rule_D2_in1">
          <text>true</text>
        </inputEntry>
        <inputEntry id="Rule_D2_in2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="Rule_D2_in3">
          <text>-</text>
        </inputEntry>
        <inputEntry id="Rule_D2_in4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="Rule_D2_in5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="Rule_D2_in6">
          <text>-</text>
        </inputEntry>
        <inputEntry id="Rule_D2_in7">
          <text>-</text>
        </inputEntry>
        <inputEntry id="Rule_D2_in8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="Rule_D2_in9">
          <text>-</text>
        </inputEntry>
        <outputEntry id="Rule_D2_out0">
          <text>"D2"</text>
        </outputEntry>
        <outputEntry id="Rule_D2_out1">
          <text>["stop", "expedite current approved source", "re-audit supplier"]</text>
        </outputEntry>
        <outputEntry id="Rule_D2_out2">
          <text>"supplier quality engineer"</text>
        </outputEntry>
        <outputEntry id="Rule_D2_out3">
          <text>["R1a", "QP-11 4.3"]</text>
        </outputEntry>
      </rule>
      <rule id="Rule_D3">
        <description>The new supplier is not qualified for the material on the drawing.</description>
        <inputEntry id="Rule_D3_in0">
          <text>"SourceChange"</text>
        </inputEntry>
        <inputEntry id="Rule_D3_in1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="Rule_D3_in2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="Rule_D3_in3">
