        <inputEntry id="Rule_D4_in0">
          <text>"MaterialChange"</text>
        </inputEntry>
        <inputEntry id="Rule_D4_in1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="Rule_D4_in2">
          <text>-</text>
        </inputEntry>
        <inputEntry id="Rule_D4_in3">
