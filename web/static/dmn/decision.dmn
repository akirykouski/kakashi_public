        </inputEntry>
        <inputEntry id="Rule_D4_in4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="Rule_D4_in5">
          <text>-</text>
        </inputEntry>
        <inputEntry id="Rule_D4_in6">
          <text>-</text>
        </inputEntry>
        <inputEntry id="Rule_D4_in7">
          <text>true</text>
        </inputEntry>
        <inputEntry id="Rule_D4_in8">
          <text>-</text>
        </inputEntry>
        <inputEntry id="Rule_D4_in9">
          <text>-</text>
        </inputEntry>
        <outputEntry id="Rule_D4_out0">
          <text>"D4"</text>
        </outputEntry>
        <outputEntry id="Rule_D4_out1">
          <text>["stop", "request customer deviation / PPAP resubmission"]</text>
        </outputEntry>
        <outputEntry id="Rule_D4_out2">
          <text>"customer"</text>
        </outputEntry>
        <outputEntry id="Rule_D4_out3">
          <text>["R6", "IATF 16949 8.3.6.1"]</text>
        </outputEntry>
      </rule>
      <rule id="Rule_D5">
        <description>No part approval for this supplier, part, plant and customer, and the customer requires approval for this change.</description>
        <inputEntry id="Rule_D5_in0">
          <text>"SourceChange"</text>
        </inputEntry>
        <inputEntry id="Rule_D5_in1">
          <text>-</text>
        </inputEntry>
        <inputEntry id="Rule_D5_in2">
          <text>true</text>
        </inputEntry>
        <inputEntry id="Rule_D5_in3">
          <text>true</text>
        </inputEntry>
        <inputEntry id="Rule_D5_in4">
          <text>-</text>
        </inputEntry>
        <inputEntry id="Rule_D5_in5">
